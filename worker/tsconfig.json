{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/worker/*": ["./src/*"],
      "@/src/*": ["../src/*"]
    }
  },
  "include": ["src/**/*", "../src/lib/**/*", "../src/types/**/*"],
  "exclude": ["node_modules", "dist"]
}
