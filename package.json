{
  "name": "namerr",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@types/ssh2": "^1.15.5",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.0.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "fast-glob": "^3.3.2",
    "ioredis": "^5.8.2",
    "nanoid": "^5.1.6",
    "next": "16.0.10",
    "pg": "^8.13.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "ssh2": "^1.17.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun scripts/seed-db.ts",
    "db:reset": "drizzle-kit drop && bun run db:push && bun run db:seed",
    "setup": "bash scripts/setup.sh",
    "setup:docker": "docker compose down -v && docker compose up -d postgres && sleep 5 && bun run db:push && bun run db:seed",
    "docker:dev": "docker compose up postgres redis",
    "docker:prod": "docker compose --profile production up -d",
    "docker:logs": "docker compose logs -f",
    "docker:stop": "docker compose down",
    "docker:clean": "docker compose down -v && docker system prune -f",
    "worker:dev": "cd worker && bun run dev",
    "worker:build": "cd worker && bun run build"
  }
}
