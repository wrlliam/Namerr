# Database
DATABASE_URL=postgresql://mediamanager:mediamanager@localhost:5432/mediamanager
POSTGRES_PASSWORD=mediamanager

# Auth
BETTER_AUTH_SECRET=generate-a-random-secret-here-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Redis (optional - used for caching if available)
# If Redis connection fails, the system will automatically fall back to in-memory cache
# Leave commented out to use in-memory cache only
# REDIS_URL=redis://localhost:6379

# Cache Configuration
# Force use of in-memory cache instead of Redis (useful for SSH workers)
# FORCE_MEMORY_CACHE=false

# Worker Configuration (stored in database, these are defaults)
# WORKER_PARALLELISM=4
# DRY_RUN_MODE=true
# SCAN_INTERVAL_HOURS=4

# Seerr Configuration (configured via UI, stored in database)
# SEERR_API_URL=http://192.168.1.130:5055
# SEERR_API_KEY=your-api-key-here

# Docker Volume Mounts (for docker-compose)
MEDIA_PATH=./media
